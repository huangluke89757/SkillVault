{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skillvault",
	"main": "worker.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "build/client"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"APP_URL": "https://skillvault.ai"
	},
	"define": {
		"import.meta.url": "\"file:///worker.js\""
	},
	"routes": [
		{
			"pattern": "skillvault.ai",
			"zone_name": "skillvault.ai",
			"custom_domain": true
		}
	]
}
